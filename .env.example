# ShopSpace environment — copy this file to `.env` and adjust as needed:
#   cp .env.example .env
# All keys are read from `.env` at runtime (flutter_dotenv). The file is
# bundled as a Flutter asset, so editing it requires a full re-run (build),
# not a hot reload.
#
# Environment selector (dev/staging/prod). All three currently point at the
# same Railway backend; they differ in logging (`isLoggingEnabled`). dev =
# logging on, prod = logging off.
APP_ENV=dev

# API base URL. Overrides the built-in per-environment base when set.
API_BASE_URL=https://shopspace-backend-production.up.railway.app

# Google Sign-In. Android has no google-services.json, so the web client ID
# MUST be provided as `serverClientId`. Without it Google sign-in fails at
# runtime with "serverClientId must be provided on Android".
GOOGLE_SERVER_CLIENT_ID=246506176135-fajj9l424b8rp5f5d6sum2rr7bfdrpoq

# iOS OAuth client ID (once the backend provisions the iOS client). Empty
# until then — the plugin falls back to GoogleService-Info.plist.
GOOGLE_IOS_CLIENT_ID=
